load("//bazel/rules/testing:whisply_test_support_binary.bzl", "whisply_test_support_binary")

package(default_visibility = ["//visibility:private"])

# Keep this target's basename aligned with the shipping binary. The app-server
# test macro deliberately lets this later extra_binaries edge override the
# CARGO_BIN_EXE_codex-app-server runfile mapping.
whisply_test_support_binary(
    name = "codex-app-server",
    binary = "//codex-rs/app-server:codex-app-server",
    testonly = True,
    visibility = ["//codex-rs/app-server:__pkg__"],
)
