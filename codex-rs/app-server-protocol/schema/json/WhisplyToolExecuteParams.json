{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "WhisplyExecutionEnvelope": {
      "additionalProperties": false,
      "description": "Trusted data that is never embedded in model-visible tool arguments.",
      "properties": {
        "accountEpoch": {
          "type": "string"
        },
        "activityID": {
          "type": "string"
        },
        "confirmationHash": {
          "type": [
            "string",
            "null"
          ]
        },
        "contentDigest": {
          "type": [
            "string",
            "null"
          ]
        },
        "deviceID": {
          "type": "string"
        },
        "expiresAtMS": {
          "format": "int64",
          "type": "integer"
        },
        "installationID": {
          "type": "string"
        },
        "leasePhase": {
          "anyOf": [
            {
              "$ref": "#/definitions/WhisplyToolLeasePhase"
            },
            {
              "type": "null"
            }
          ]
        },
        "leaseToken": {
          "type": [
            "string",
            "null"
          ]
        },
        "nonce": {
          "type": "string"
        },
        "originDigest": {
          "type": [
            "string",
            "null"
          ]
        },
        "serverIntentGrantID": {
          "type": [
            "string",
            "null"
          ]
        },
        "skillRunID": {
          "type": [
            "string",
            "null"
          ]
        },
        "taskID": {
          "type": [
            "string",
            "null"
          ]
        },
        "taskVersion": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "threadID": {
          "type": "string"
        },
        "turnID": {
          "type": "string"
        }
      },
      "required": [
        "accountEpoch",
        "activityID",
        "deviceID",
        "expiresAtMS",
        "installationID",
        "nonce",
        "threadID",
        "turnID"
      ],
      "type": "object"
    },
    "WhisplyToolLeasePhase": {
      "description": "Closed trusted lease phases. Unknown values fail deserialization rather than becoming an execution permission.",
      "enum": [
        "prepare",
        "execute",
        "verify",
        "commit",
        "resume"
      ],
      "type": "string"
    },
    "WhisplyToolModelCall": {
      "additionalProperties": false,
      "description": "Model-visible first-party tool call. Authority data is deliberately absent.",
      "properties": {
        "arguments": true,
        "executionID": {
          "type": "string"
        },
        "schemaVersion": {
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        },
        "toolID": {
          "type": "string"
        }
      },
      "required": [
        "arguments",
        "executionID",
        "schemaVersion",
        "toolID"
      ],
      "type": "object"
    },
    "WhisplyToolPolicyDecision": {
      "description": "An independently-produced policy decision. Aggregation must only make a decision stricter; a call may not use this wire object to relax policy.",
      "oneOf": [
        {
          "properties": {
            "kind": {
              "enum": [
                "allowed"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "title": "AllowedWhisplyToolPolicyDecision",
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "setup_required"
              ],
              "type": "string"
            },
            "route": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "route"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "confirmation_required"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "title": "ConfirmationRequiredWhisplyToolPolicyDecision",
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "denied"
              ],
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "unavailable"
              ],
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "WhisplyToolPolicyInput": {
      "additionalProperties": false,
      "description": "Per-owner policy inputs for exactly one execution.",
      "properties": {
        "connectorDecision": {
          "$ref": "#/definitions/WhisplyToolPolicyDecision"
        },
        "finalConfirmationDecision": {
          "$ref": "#/definitions/WhisplyToolPolicyDecision"
        },
        "modeDecision": {
          "$ref": "#/definitions/WhisplyToolPolicyDecision"
        },
        "nativePermissionDecision": {
          "$ref": "#/definitions/WhisplyToolPolicyDecision"
        },
        "serverDecision": {
          "$ref": "#/definitions/WhisplyToolPolicyDecision"
        },
        "subscriptionDecision": {
          "$ref": "#/definitions/WhisplyToolPolicyDecision"
        },
        "targetOrFileDecision": {
          "$ref": "#/definitions/WhisplyToolPolicyDecision"
        },
        "upstreamSandboxDecision": {
          "$ref": "#/definitions/WhisplyToolPolicyDecision"
        }
      },
      "required": [
        "connectorDecision",
        "finalConfirmationDecision",
        "modeDecision",
        "nativePermissionDecision",
        "serverDecision",
        "subscriptionDecision",
        "targetOrFileDecision",
        "upstreamSandboxDecision"
      ],
      "type": "object"
    }
  },
  "description": "Trusted server-to-native execution request for `whisply/tool/execute`.",
  "properties": {
    "call": {
      "$ref": "#/definitions/WhisplyToolModelCall"
    },
    "envelope": {
      "$ref": "#/definitions/WhisplyExecutionEnvelope"
    },
    "policyInputs": {
      "$ref": "#/definitions/WhisplyToolPolicyInput"
    }
  },
  "required": [
    "call",
    "envelope",
    "policyInputs"
  ],
  "title": "WhisplyToolAppServerExecuteRequest",
  "type": "object"
}