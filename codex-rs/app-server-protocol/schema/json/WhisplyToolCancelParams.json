{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "WhisplyExecutionEnvelope": {
      "additionalProperties": false,
      "description": "Trusted data that is never embedded in model-visible tool arguments.",
      "properties": {
        "accountEpoch": {
          "type": "string"
        },
        "activityID": {
          "type": "string"
        },
        "confirmationHash": {
          "type": [
            "string",
            "null"
          ]
        },
        "contentDigest": {
          "type": [
            "string",
            "null"
          ]
        },
        "deviceID": {
          "type": "string"
        },
        "expiresAtMS": {
          "format": "int64",
          "type": "integer"
        },
        "installationID": {
          "type": "string"
        },
        "leasePhase": {
          "anyOf": [
            {
              "$ref": "#/definitions/WhisplyToolLeasePhase"
            },
            {
              "type": "null"
            }
          ]
        },
        "leaseToken": {
          "type": [
            "string",
            "null"
          ]
        },
        "nonce": {
          "type": "string"
        },
        "originDigest": {
          "type": [
            "string",
            "null"
          ]
        },
        "serverIntentGrantID": {
          "type": [
            "string",
            "null"
          ]
        },
        "skillRunID": {
          "type": [
            "string",
            "null"
          ]
        },
        "taskID": {
          "type": [
            "string",
            "null"
          ]
        },
        "taskVersion": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "threadID": {
          "type": "string"
        },
        "turnID": {
          "type": "string"
        }
      },
      "required": [
        "accountEpoch",
        "activityID",
        "deviceID",
        "expiresAtMS",
        "installationID",
        "nonce",
        "threadID",
        "turnID"
      ],
      "type": "object"
    },
    "WhisplyToolLeasePhase": {
      "description": "Closed trusted lease phases. Unknown values fail deserialization rather than becoming an execution permission.",
      "enum": [
        "prepare",
        "execute",
        "verify",
        "commit",
        "resume"
      ],
      "type": "string"
    }
  },
  "description": "Trusted cancellation request for `whisply/tool/cancel`.",
  "properties": {
    "envelope": {
      "$ref": "#/definitions/WhisplyExecutionEnvelope"
    },
    "executionID": {
      "type": "string"
    }
  },
  "required": [
    "envelope",
    "executionID"
  ],
  "title": "WhisplyToolAppServerCancelRequest",
  "type": "object"
}