    },
    "clientUserMessageID": {
      "type": "string"
    },
    "threadID": {
      "type": "string"
    },
    "turnID": {
      "type": "string"
    }
  },
  "required": [
    "admissionID",
    "call",
    "clientUserMessageID",
    "threadID",
    "turnID"
  ],
  "title": "WhisplyToolAdmittedExecuteRequest",
  "type": "object"
