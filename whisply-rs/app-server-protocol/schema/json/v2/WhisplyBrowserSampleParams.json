{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "WhisplyBrowserSamplingPayload": {
      "additionalProperties": false,
      "description": "Browser-only model material. No task, account, lease or native command authority can be supplied through this payload.",
      "properties": {
        "inputJSON": {
          "type": "string"
        },
        "maximumOutputTokens": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "modelID": {
          "type": "string"
        },
        "outputSchemaJSON": {
          "type": "string"
        },
        "purpose": {
          "$ref": "#/definitions/WhisplyBrowserSamplingPurpose"
        },
        "reasoningEffort": {
          "type": [
            "string",
            "null"
          ]
        },
        "systemPrompt": {
          "type": "string"
        },
        "visualJPEGDataURL": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "inputJSON",
        "maximumOutputTokens",
        "modelID",
        "outputSchemaJSON",
        "purpose",
        "systemPrompt"
      ],
      "type": "object"
    },
    "WhisplyBrowserSamplingPurpose": {
      "enum": [
        "planning",
        "visual_verification"
      ],
      "type": "string"
    }
  },
  "description": "The reference is resolved through the existing native broker for this runtime process. A matching digest is required before model sampling.",
  "properties": {
    "payload": {
      "$ref": "#/definitions/WhisplyBrowserSamplingPayload"
    },
    "reference": {
      "type": "string"
    }
  },
  "required": [
    "payload",
    "reference"
  ],
  "title": "WhisplyBrowserSampleParams",
  "type": "object"
}