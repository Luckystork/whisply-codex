load("//:defs.bzl", "codex_rust_crate")

codex_rust_crate(
    name = "app-server",
    # This sibling target has the same basename as the normal binary. The
    # macro removes the normal binary only from integration-test runfiles and
    # maps CARGO_BIN_EXE_codex-app-server to this transitioned test binary.
    binary_overrides = {
        "codex-app-server": "//whisply-rs/app-server/testing:codex-app-server",
    },
    crate_name = "whisply_app_server",
    extra_binaries = [
        "//whisply-rs/bwrap:bwrap",
        "//whisply-rs/code-mode-host:codex-code-mode-host",
        "//whisply-rs/rmcp-client:test_stdio_server",
    ],
    extra_binaries_non_windows = [
        "//whisply-rs/cli:codex",
    ],
    integration_test_timeout = "long",
    run_tests_with_wine_exec = True,
    test_shard_counts = {
        # Note app-server-all-test has a large number of integration tests, so
        # even a single shard can be quite slow. When there is a legitimate
        # test failure in a shard, it will still get run 3x in total, which
        # can cause us to exhaust our CI timeout if the shard happens to run
        # long. Using a higher shard count for app-server-all-test should help
        # mitigate this risk.
        "app-server-all-test": 16,
        "app-server-unit-tests": 8,
    },
    test_tags = ["no-sandbox"],
)
